---
import { getCollection, getEntry } from "astro:content";
import { SITE_URL } from "astro:env/client";
import { PAGES_ROUTES } from "@const/index";
import type { SeoMetadata } from "@const/types";
import ArticleCard from "@modules/core/components/articleCard/ArticleCard.astro";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import type { InferGetStaticParamsType, InferGetStaticPropsType } from "astro";
import "./_tag.css";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
type TagParams = InferGetStaticParamsType<typeof getStaticPaths>;

export const prerender = true;

export async function getStaticPaths() {
	const tags = await getCollection("tags");
	const uniqueTags = new Map<string, (typeof tags)[number]["data"]["tags"][number]>();

	for (const tag of tags.flatMap((tag) => tag.data.tags)) {
		if (!uniqueTags.has(tag.slug)) {
			uniqueTags.set(tag.slug, tag);
		}
	}

	return await Promise.all(
		[...uniqueTags.values()].map(async (tag) => {
			const articles = await Promise.all(
				tag.articles.map(async (article) => await getEntry(article.collection, article.id)),
			);

			return {
				params: {
					slug: tag.slug,
				},
				props: {
					tag: {
						...tag,
						articles: articles
							.filter((article): article is NonNullable<typeof article> => Boolean(article))
							.sort((a, b) => b.data.publishDateISO.localeCompare(a.data.publishDateISO)),
					},
				},
			};
		}),
	);
}

const { slug } = Astro.params as TagParams;
const { tag } = Astro.props;
const metadata: Partial<SeoMetadata> = {
	title: `#${slug}`,
	description: `Articles tagged with #${slug}.`,
};

const itemListSchema = buildItemListSchema(
	(tag.articles ?? []).map((article) => new URL(`${PAGES_ROUTES.ARTICLE}${article.data.slug}`, SITE_URL).href),
);
---
<BaseLayout {...metadata}>
    <Breadcrumbs />
    <h1 class="flex justify-center">#{slug}(&times;{tag.count})</h1>    <section class="common-wrapper">
    <ul class="tag__article__list grid">
      {tag.articles?.map((article) => {
        return (
            <li class="tag__article__item relative">
                <ArticleCard {...article} isLandscape />
            </li>
        )
      })}
    </ul>
</section>
    <script is:inline type="application/ld+json" set:html={itemListSchema} />
</BaseLayout>
