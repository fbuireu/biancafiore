---
import type { SeoMetadata } from "@const/types";
import ArticleCard from "@modules/core/components/articleCard/ArticleCard.astro";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { readArticles, readTag, resolveArticles } from "@modules/core/utils/entries";
import { buildArticleListSchema } from "@modules/core/utils/jsonLd";
import { tagPageCopy } from "@modules/core/utils/tagPage";
import "./_page-tags.css";
import "./_tag.css";

const entry = Astro.params.slug ? await readTag(Astro.params.slug) : undefined;

if (!entry) return Astro.rewrite("/404");

const tag = entry.data;
const articles = resolveArticles({ references: tag.articles, articles: await readArticles() });
const { heading, title, description } = tagPageCopy(tag);

const metadata: Partial<SeoMetadata> = { title, description };

const itemListSchema = buildArticleListSchema(articles.map(({ data }) => data.slug));
---
<BaseLayout {...metadata}>
    <Breadcrumbs />
    <h1 class="flex justify-center reveal">{heading}(&times;{articles.length})</h1>    <section class="common-wrapper">
    <ul class="tag__article__list grid">
      {articles.map((article) => {
        return (
            <li class="tag__article__item relative reveal-once">
                <ArticleCard article={article} isLandscape />
            </li>
        )
      })}
    </ul>
</section>
    <JsonLd schema={itemListSchema} />
</BaseLayout>
