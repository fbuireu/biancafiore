---
import { getCollection } from "astro:content";
import type { SeoMetadata } from "@const/types";
import ArticleCard from "@modules/core/components/articleCard/ArticleCard.astro";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { resolveArticles } from "@modules/core/utils/entries";
import { buildArticleListSchema } from "@modules/core/utils/jsonLd";
import type { InferGetStaticParamsType, InferGetStaticPropsType } from "astro";
import "./_tag.css";

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
type TagParams = InferGetStaticParamsType<typeof getStaticPaths>;

export const prerender = true;

export async function getStaticPaths() {
	const tags = await getCollection("tags");

	return tags.map(({ data }) => ({ params: { slug: data.slug }, props: { tag: data } }));
}

const { slug } = Astro.params as TagParams;
const { tag } = Astro.props;
const articles = await resolveArticles(tag.articles);

const metadata: Partial<SeoMetadata> = {
	title: `#${slug}`,
	description: `Articles tagged with #${slug}.`,
};

const itemListSchema = buildArticleListSchema(articles.map(({ data }) => data.slug));
---
<BaseLayout {...metadata}>
    <Breadcrumbs />
    <h1 class="flex justify-center reveal">#{slug}(&times;{articles.length})</h1>    <section class="common-wrapper">
    <ul class="tag__article__list grid">
      {articles.map((article) => {
        return (
            <li class="tag__article__item relative reveal">
                <ArticleCard {...article} isLandscape />
            </li>
        )
      })}
    </ul>
</section>
    <JsonLd schema={itemListSchema} />
</BaseLayout>
