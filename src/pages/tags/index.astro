---
import { getCollection } from "astro:content";
import { absoluteUrl, tagHref } from "@const/index";
import type { SeoMetadata } from "@const/types";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import { groupBy } from "@shared/utils/objects";
import "./_tags.css";

export const prerender = true;

const tags = await getCollection("tags");
const letters = groupBy({
	array: tags.map(({ data }) => data),
	keyFn: ({ name }) => name.charAt(0).toUpperCase(),
});

const metadata: Partial<SeoMetadata> = {
	title: "Tags",
	description: "Browse all topics and tags from Bianca Fiore's articles.",
};

const itemListSchema = buildItemListSchema(tags.map(({ data }) => absoluteUrl(tagHref(data.slug))));
---
<BaseLayout {...metadata}>
    <Breadcrumbs />
    <section class="common-wrapper">
        <h1 class="flex justify-center reveal">All tags</h1>
        <ul class="tags__list grid">
          {Object.entries(letters).map(([letter, letterTags]) => (
              <li class="tags__item">
                  <h2 class="tags__item__letter reveal">{letter}</h2>
                  <ul class="tags__item__list flex column-wrap">
                    {letterTags.map((tag) => (
                        <li class="tag__item font-sans-serif clickable reveal">
                            <a href={tagHref(tag.slug)} class="underline-on-hover">{tag.name}(&times;{tag.articles.length})</a>
                        </li>
                    ))}
                  </ul>
              </li>
          ))}
        </ul>
    </section>
    <script is:inline type="application/ld+json" set:html={itemListSchema} />
</BaseLayout>
