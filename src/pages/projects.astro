---
import { getCollection } from "astro:content";
import { SITE_URL } from "astro:env/client";
import { PAGES_ROUTES } from "@const/index";
import type { SeoMetadata } from "@const/types";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import ProjectSection from "@modules/projects/components/projectSection/ProjectSection.astro";
import ProjectsIntro from "@modules/projects/components/projectsIntro/ProjectsIntro.astro";

export const prerender = true;

const projects = await getCollection("projects");
const itemListSchema = buildItemListSchema(
	projects.map((project) => new URL(`${PAGES_ROUTES.PROJECTS}#${project.data.id}`, SITE_URL).href),
);
const metadata: Partial<SeoMetadata> = {
	title: "Projects",
	description: "Explore Bianca Fiore's portfolio of web development projects and case studies.",
};
---
<BaseLayout {...metadata}>
    <ProjectsIntro />
  {projects.map((project, index) => (
      <ProjectSection id={project.data.id}>
          <article style={`--index: ${index}`} class="project-wrapper">
              <div class="project-image-wrapper">
                  <BlurImage class="project-image" layout="full-width" src={project.data.image.url} alt={project.data.name}
                         width={project.data.image.details.width} height={project.data.image.details.height}
                         placeholder={project.data.image.placeholder} loading={index === 0 ? "eager" : "lazy"} />
              </div>
              <div class="project-information">
                  <h2 class="project-title editorial-headline">{project.data.name}</h2>
                  <div set:html={project.data.description} />
              </div>
          </article>
      </ProjectSection>
  ))}
    <script is:inline type="application/ld+json" set:html={itemListSchema} />
</BaseLayout>
