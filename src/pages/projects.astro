---
import { getCollection } from "astro:content";
import type { SeoMetadata } from "@const/types";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { buildProjectListSchema } from "@modules/core/utils/jsonLd";
import ProjectSection from "@modules/projects/components/projectSection/ProjectSection.astro";
import ProjectsIntro from "@modules/projects/components/projectsIntro/ProjectsIntro.astro";

export const prerender = true;

const projects = await getCollection("projects");
const itemListSchema = buildProjectListSchema(projects.map(({ data }) => data.id));
const metadata: Partial<SeoMetadata> = {
	title: "Projects",
	description: "Explore the disciplines Bianca Fiore works in, and what each one covers.",
};
---
<BaseLayout {...metadata}>
    <ProjectsIntro />
  {projects.map((project, index) => (
      <ProjectSection id={project.data.id}>
          <article class="project-section__inner">
              <div class="project-section__image-wrapper">
                  <BlurImage class="project-section__image" layout="full-width" image={project.data.image} alt={project.data.name}
                         loading={index === 0 ? "eager" : "lazy"} />
              </div>
              <div class="project-section__information">
                  <h2 class="project-section__title editorial-headline">{project.data.name}</h2>
                  <div set:html={project.data.description} />
              </div>
          </article>
      </ProjectSection>
  ))}
    <JsonLd schema={itemListSchema} />
</BaseLayout>
