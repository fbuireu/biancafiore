---
import type { SeoMetadata } from "@const/types";
import ContactIntro from "@modules/contact/components/contactIntro/ContactIntro.astro";
import Tabs from "@modules/contact/components/tabs/Tabs.astro";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import LatestArticles from "@modules/core/components/latestArticles/LatestArticles.astro";
import { buildContactPageSchema } from "@modules/core/utils/jsonLd";

export const prerender = true;

const metadata: Partial<SeoMetadata> = {
	title: "Contact",
	description: "Get in touch with me",
};

const contactPageSchema = buildContactPageSchema({
	path: Astro.url.pathname,
	name: "Contact Bianca Fiore",
	description: "Get in touch with Bianca Fiore.",
});
---
<BaseLayout {...metadata}>
  <Breadcrumbs />
  <ContactIntro />
  <Tabs />
  <LatestArticles />
  <JsonLd schema={contactPageSchema} />
</BaseLayout>
