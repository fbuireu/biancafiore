---
import { articleHref } from "@const/index";
import type { SeoMetadata } from "@const/types";
import AboutBlogPreview from "@modules/about/components/aboutBlogPreview/AboutBlogPreview.astro";
import AboutIntro from "@modules/about/components/aboutIntro/AboutIntro.astro";
import LittleMoreOfMe from "@modules/about/components/littleMoreOfMe/LittleMoreOfMe.astro";
import WhatIDo from "@modules/about/components/whatIDo/WhatIDo.astro";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { getSiteAuthor, readArticles, readCities, resolveArticle } from "@modules/core/utils/entries";
import { buildProfilePageSchema } from "@modules/core/utils/jsonLd";

const [cities, bianca, articles] = await Promise.all([readCities(), getSiteAuthor(), readArticles()]);

const latestArticle = resolveArticle({ reference: bianca.data.latestArticle, articles });

const metadata: Partial<SeoMetadata> = {
	title: "About me",
	description: bianca.data.description,
	image: bianca.data.profileImage.url,
};

const profilePageSchema = buildProfilePageSchema({
	person: {
		id: "#bianca",
		name: bianca.data.name,
		path: Astro.url.pathname,
		image: bianca.data.profileImage.url,
		jobTitle: bianca.data.jobTitle,
		company: bianca.data.currentCompany,
		sameAs: [...bianca.data.socialNetworks],
	},
	...(latestArticle && {
		latestArticle: {
			headline: latestArticle.data.title,
			path: articleHref(latestArticle.data.slug),
			datePublished: latestArticle.data.publishDateISO,
		},
	}),
});
---
<BaseLayout {...metadata}>
    <Breadcrumbs />
    <AboutIntro />
    <WhatIDo />
    <LittleMoreOfMe cities={cities} />
    <AboutBlogPreview />
    <JsonLd schema={profilePageSchema} />
</BaseLayout>
