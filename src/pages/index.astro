---
import { PAGES_ROUTES } from "@const/index";
import type { SeoMetadata } from "@const/types";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { getSiteAuthor, readSiteSettings } from "@modules/core/utils/entries";
import { buildWebSiteSchema } from "@modules/core/utils/jsonLd";
import Blog from "@modules/home/components/blog/Blog.astro";
import ProjectList from "@modules/home/components/projectList/ProjectList.astro";
import Testimonials from "@modules/home/components/testimonials/Testimonials.astro";
import Welcome from "@modules/home/components/welcome/Welcome.astro";

const [bianca, site] = await Promise.all([getSiteAuthor(), readSiteSettings(Astro.isPrerendered)]);

const metadata: Partial<SeoMetadata> = {
	description: bianca.data.description,
	image: bianca.data.profileImage.url,
};

const webSiteSchema = buildWebSiteSchema({
	path: PAGES_ROUTES.HOME,
	name: site.title,
	description: bianca.data.description,
	author: {
		name: bianca.data.name,
		jobTitle: bianca.data.jobTitle,
		path: PAGES_ROUTES.ABOUT,
	},
});
---
<BaseLayout {...metadata}>
    <Welcome />
    <ProjectList />
    <Testimonials />
    <Blog />
    <JsonLd schema={webSiteSchema} />
</BaseLayout>
