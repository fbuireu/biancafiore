const authors = await getCollection("authors");
const bianca = authors.find((a) => a.data.name === CONTACT_DETAILS.NAME) as CollectionEntry<"authors">;

const metadata: Partial<SeoMetadata> = {
	description: bianca.data.description,
	image: bianca.data.profileImage.url,
};

const webSiteSchema = buildWebSiteSchema({
	url: absoluteUrl(PAGES_ROUTES.HOME),
	name: "Bianca Fiore",
	description: bianca.data.description,
	author: {
		name: bianca.data.name,
		jobTitle: bianca.data.jobTitle,
		url: absoluteUrl(PAGES_ROUTES.ABOUT),
	},
});
---
<BaseLayout {...metadata}>
    <Welcome />
    <MyWork />
    <Testimonials />
    <Blog />
    <script is:inline type="application/ld+json" set:html={webSiteSchema} />
</BaseLayout>
