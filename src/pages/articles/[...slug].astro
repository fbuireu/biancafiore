---
import { getImage } from "astro:assets";
import { PAGES_ROUTES } from "@const/index";
import type { SeoMetadata } from "@const/types";
import ArticleContent from "@modules/article/components/articleContent/ArticleContent.astro";
import ArticleDetails from "@modules/article/components/articleDetails/ArticleDetails.astro";
import ColumnsToggle from "@modules/article/components/columnsToggle/ColumnsToggle.astro";
import PreviewBanner from "@modules/article/components/previewBanner/PreviewBanner.astro";
import ReadingProgress from "@modules/article/components/readingProgress/ReadingProgress.astro";
import RepublishedBanner from "@modules/article/components/republishedBanner/RepublishedBanner.astro";
import TableOfContents from "@modules/article/components/tableOfContents/TableOfContents.astro";
import { ARTICLE_BODY_CLASS, ARTICLE_FEATURED_IMAGE_CLASS, ARTICLE_MASTHEAD_CLASS } from "@modules/article/const";
import { shareImage } from "@modules/article/utils/shareImage";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import { featuredImageTransitionName } from "@modules/core/components/blurImage/utils/transition";
import Breadcrumbs from "@modules/core/components/breadcrumbs/Breadcrumbs.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import RelatedArticles from "@modules/core/components/relatedArticles/RelatedArticles.astro";
import { readArticle } from "@modules/core/utils/entries";
import { buildBlogPostingSchema } from "@modules/core/utils/jsonLd";
import "./_article.css";

const article = Astro.params.slug ? await readArticle(Astro.params.slug) : undefined;

if (!article) return Astro.rewrite("/404");

const tagNames = article.data.tags?.map(({ name }) => name);
const metadata: Partial<SeoMetadata> = {
	...article.data.seo,
	type: "article",
	publishedTime: article.data.publishDateISO,
	modifiedTime: article.data.updatedAt,
	author: article.data.author.name,
	tags: tagNames,
};
const scopes = article.data.tableOfContents.map(({ scope }) => scope).join(",");
const blogPostingSchema = buildBlogPostingSchema({
	path: Astro.url.pathname,
	headline: article.data.title,
	description: article.data.description,
	images: [await shareImage({ image: article.data.featuredImage ?? article.data.author.profileImage, getImage })],
	datePublished: article.data.publishDateISO,
	dateModified: article.data.updatedAt,
	author: {
		name: article.data.author.name,
		jobTitle: article.data.author.jobTitle,
		path: PAGES_ROUTES.ABOUT,
	},
	publisher: {
		name: article.data.author.name,
		path: PAGES_ROUTES.HOME,
	},
	keywords: tagNames,
});
---
<BaseLayout {...metadata}>
  {
      article.data.featuredImage && (
          <section class="article__featured-image-wrapper">
              <BlurImage
                  image={article.data.featuredImage}
                  widths={[640, 960, 1280, 1920]}
                  sizes="100vw"
                  alt={article.data.title}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class={ARTICLE_FEATURED_IMAGE_CLASS}
                  transitionName={featuredImageTransitionName(article.data.slug)}
              />
          </section>
      )
  }
    <ReadingProgress />
    <div class:list={[ARTICLE_MASTHEAD_CLASS, { "article-masthead--featured": !!article.data.featuredImage }]}>
      <Breadcrumbs />
      <ArticleDetails article={article} />
    </div>
    {article.data.isPreview && <PreviewBanner />}
    {article.data.isRepublished && (
      <RepublishedBanner originalSource={article.data.originalSource} />
    )}
    <ColumnsToggle />
    <article class={ARTICLE_BODY_CLASS} style={`--scopes: ${scopes}`}>
      {
          article.data.tableOfContents.length > 0 &&
          <TableOfContents tableOfContents={article.data.tableOfContents} />
      }
      <ArticleContent content={article.data.content} />
    </article>
    <JsonLd schema={blogPostingSchema} />
    <RelatedArticles article={article} />
</BaseLayout>
