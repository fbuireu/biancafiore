---
import type { SeoMetadata } from "@const/types";
import BaseLayout from "@modules/core/components/baseLayout/BaseLayout.astro";
import EmailButton from "@modules/core/components/emailButton/EmailButton.astro";
import LegalSection from "@modules/legal/components/legalSection/LegalSection.astro";
import { formatDate } from "@shared/utils/dates";

export const prerender = true;

const lastUpdated = formatDate("2026-05-18");
const metadata: Partial<SeoMetadata> = {
	title: "Privacy Policy",
	robots: {
		index: false,
		follow: false,
	},
};
---
<BaseLayout {...metadata}>
  <div class="privacy-policy-wrapper common-wrapper">
    <LegalSection>
        <h1>Privacy Policy</h1>
    </LegalSection>
    <LegalSection><p>Last updated: {lastUpdated}</p></LegalSection>
    <LegalSection>
        <p>Thank you for visiting biancafiore.me ("Website"). Your privacy is important to us. This Privacy Policy explains
          what personal data we collect, how we use and share it, and your rights regarding this data. The data controller is
          Bianca Fiore, the individual who owns and operates this Website; you can reach out using the contact details in the
          "Your Rights" section below.</p>
    </LegalSection>
    <LegalSection>
        <h4>Personal Data We Collect</h4>
        <p>a) <strong>Automatically Collected Data:</strong> When you visit our Website, our hosting provider automatically
          processes certain technical information from your device, such as your IP address, browser type, and the pages you
          visit, in order to serve the Website securely.</p>

        <p>b) <strong>Cookies and Similar Technologies:</strong> We use cookies and similar technologies (such as localStorage)
          to store user preferences, such as the selected theme. You can manage your cookie preferences through the "Manage
          cookies" link in the footer or through your browser settings.</p>

        <p>c) <strong>Google Analytics:</strong> We use Google Analytics with consent mode enabled to collect statistical data
          about the usage of the Website, maintaining an appropriate level of data protection. You can opt out of data
          collection by disabling Google Analytics cookies in your browser settings.</p>

        <p>d) <strong>Contact Form:</strong> When you use our contact form, we collect your name, email address, and message.
          This data is securely stored in our database and used only to respond to your inquiry. To deliver your message, it is
          processed by our email provider, Resend.</p>

        <p>e) <strong>Spam Protection:</strong> Our contact form uses Google reCAPTCHA to prevent automated abuse. reCAPTCHA may
          process your IP address and interactions with the form; this processing is governed by Google's own privacy
          policy.</p>

        <p>f) <strong>Scheduling a Call:</strong> If you choose to book a call through the "Make an appointment" tab on our
          Contact page, that section is provided by Calendly and only loads once you open it. Any information you enter there
          is processed by Calendly under its own privacy policy.</p>
    </LegalSection>
    <LegalSection>
        <h4>Use of Information</h4>
        <p>We use the collected information to:</p>
        <ul>
          <li>Personalize your experience on the Website, including storing the selected theme.</li>
          <li>Analyze Website usage through Google Analytics to improve our services and content.</li>
          <li>Respond to your inquiries and provide requested information via the contact form.</li>
          <li>Protect the Website and its contact form from spam and abuse.</li>
        </ul>
    </LegalSection>
    <LegalSection>
        <h4>Legal Basis for Processing</h4>
        <p>The legal basis for processing your personal data is your consent, which you provide by using our Website and
          accepting our privacy practices through the cookie banner, and, where applicable, our legitimate interest in
          responding to your inquiries and keeping the Website secure.</p>
    </LegalSection>
    <LegalSection>
        <h4>Sharing of Information</h4>
        <p>We do not sell your personal data. We only share it with the service providers described above (our hosting
          provider, Resend, Google Analytics, Google reCAPTCHA, and, where applicable, Calendly) to the extent necessary for
          them to provide their service to us, or when necessary to comply with legal obligations or respond to legitimate
          requests from public authorities.</p>
    </LegalSection>
    <LegalSection>
        <h4>Data Retention</h4>
        <p>We keep the information submitted through the contact form for as long as necessary to respond to your inquiry and
          to keep a reasonable record of our correspondence, unless you ask us to delete it sooner.</p>
    </LegalSection>
    <LegalSection>
        <h4>Data Security</h4>
        <p>We implement appropriate technical and organizational measures to protect your personal data against unauthorized or
          unlawful access and against accidental loss, destruction, or damage.</p>
    </LegalSection>
    <LegalSection>
        <h4>Your Rights</h4>
        <p>You have the right to access, rectify, delete, restrict, or object to the processing of your personal data. You can
          exercise these rights by emailing us at <EmailButton classNames="legal-page__email" shows="address" />.
          If you believe your data protection rights have not been respected, you also have the right to lodge a complaint with
          your local data protection supervisory authority.</p>
    </LegalSection>
    <LegalSection>
        <h4>Changes to this Privacy Policy</h4>
        <p>We reserve the right to update this Privacy Policy at any time. The updated version will be posted on the Website
          along with the last updated date.</p>
    </LegalSection>
  </div>
</BaseLayout>
