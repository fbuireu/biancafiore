---
import { formatPeriod } from "@domain/city";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import type { CityEntry } from "@modules/core/utils/entries";
import "./cities.css";

interface Props {
	cities: CityEntry[];
}

const { cities } = Astro.props;
---
<ul class="cities__list">
	{
		cities.map(({ data }) => (
			<li class="cities__item" id={data.slug}>
				<article class="cities__content">
					<BlurImage
						class="cities__content__image"
						image={data.image}
						alt={data.name}
						loading="lazy"
						decoding="async"
					/>
					<p class="cities__content__period editorial-meta editorial-meta--gold">{formatPeriod(data.period)}</p>
					<h3 class="cities__content__name">{data.name}</h3>
					<p class="cities__content__description">{data.description}</p>
				</article>
			</li>
		))
	}
</ul>
