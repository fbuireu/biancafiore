---
import type { CityEntry } from "@modules/core/utils/entries";
import { toCityPoints } from "../../utils/globe";
import Cities from "../cities/Cities.astro";
import { WorldGlobe } from "../worldGlobe/WorldGlobe";
import "./little-more-of-me.css";

interface Props {
	cities: CityEntry[];
}

const { cities } = Astro.props;

const points = toCityPoints(cities);
---

<section class="little-more-of-me-wrapper common-wrapper">
    <h2 class="little-more-of-me__title editorial-section-title reveal">A little more of me</h2>
    <div class="little-more-of-me__inner flex">
        <WorldGlobe points={points} client:load />
        <Cities cities={cities} />
    </div>
</section>

