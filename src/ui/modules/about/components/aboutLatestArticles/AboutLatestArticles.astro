---
import { getCollection } from "astro:content";
import { absoluteUrl, articleHref, PAGES_ROUTES } from "@const/index";
import ArticleSlider from "@modules/core/components/articleSlider/ArticleSlider.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import "./about-latest-articles.css";

const articles = await getCollection("articles");

const itemListSchema = buildItemListSchema(articles.map(({ data: { slug } }) => absoluteUrl(articleHref(slug))));
---
<section class="about-latest-articles-wrapper common-wrapper">
    <h2 class="about-latest-articles__title editorial-section-title reveal">
        Fresh from <a class="about-latest-articles__title__link clickable underline-on-hover" href={`${PAGES_ROUTES.ARTICLES}`}>the blog</a>
    </h2>
    <div class="about-latest-articles__inner">
        <div class="about-latest-articles__quote-wrapper reveal">
            <h4 class="about-latest-articles__quote">Lorem ipsum dolir sit Amet. Dolor sit amet.</h4>
            <h6 class="about-latest-articles__quote__author">Ferran Buireu</h6>
        </div>
        <ArticleSlider articles={articles} class="about-latest-articles__slider" />
        <script is:inline type="application/ld+json" set:html={itemListSchema} />
    </div>
</section>
