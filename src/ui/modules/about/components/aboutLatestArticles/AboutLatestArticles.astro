---
import { PAGES_ROUTES } from "@const/index";
import ArticleSlider from "@modules/core/components/articleSlider/ArticleSlider.astro";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import { blogTeaser } from "@modules/core/utils/blogTeaser";
import "./about-latest-articles.css";

const MAX_LATEST_ARTICLES = 4;

const { articles, itemListSchema } = await blogTeaser(MAX_LATEST_ARTICLES);
---
<section class="about-latest-articles-wrapper common-wrapper">
    <h2 class="about-latest-articles__title editorial-section-title reveal">
        Fresh from <a class="about-latest-articles__title__link clickable underline-on-hover" href={`${PAGES_ROUTES.ARTICLES}`}>the blog</a>
    </h2>
    <div class="about-latest-articles__inner">
        <ArticleSlider articles={articles} class="about-latest-articles__slider" />
        <JsonLd schema={itemListSchema} />
    </div>
</section>
