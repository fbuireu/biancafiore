---
import { Image } from "astro:assets";
import bianca from "@assets/images/jpg/bianca-fiore.jpg";
import "./contact-intro.css";
---
<section class="contact-intro-wrapper common-wrapper">
    <div class="contact-intro__section contact-intro__section--left flex column-wrap justify-center">
        <p class="editorial-eyebrow contact-intro__eyebrow reveal">Get in touch</p>
        <h1 class="contact-intro__title editorial-headline reveal" data-reveal-index="1">Say hello!</h1>
        <div class="contact-intro__body font-serif flex column-wrap reveal" data-reveal-index="2">
            <p>
                Commissions, collaborations, or a question about something I wrote: all of it is welcome. Use the form
                and I read it myself, or book a call if it is easier to talk it through.
            </p>
        </div>
    </div>
    <div class="contact-intro__section contact-intro__section--right flex row-wrap">
        <Image src={bianca} alt="Bianca Fiore" class="contact-intro__image reveal reveal--fade" loading="eager" />
    </div>
</section>
