---
import { CALENDLY, CALENDLY_MEETING_URL } from "@const/calendly";
import { ContactFormProvider } from "../contactFormProvider/ContactFormProvider";
import { TAB_ACTIVE_CLASS, TAB_CLASS, TAB_CONTENT_ACTIVE_CLASS, TAB_CONTENT_CLASS, TabId } from "./const";
import { activeTab } from "./utils/tabs";
import "./tabs.css";

const selected = activeTab(Astro.url);
---

<section class="tabs-wrapper">
	<div class="tabs__inner common-wrapper">
		<div class="tabs__header flex column-wrap">
			<h2 class="tabs__title section-title">Contact me</h2>
			<hr class="tabs__divider" />
			<p class="tabs__body">Multiple ways to get in touch with me :)</p>
		</div>
		<ul class="tabs__list flex" role="tablist" aria-label="Ways to get in touch">
			<li class:list={[
					TAB_CLASS,
					"underline-on-hover",
					{ [TAB_ACTIVE_CLASS]: selected === TabId.EMAIL, "underline-on-hover--active": selected === TabId.EMAIL },
				]} data-target={TabId.EMAIL} role="presentation">
				<button type="button" role="tab" id={`${TabId.EMAIL}-tab`} aria-controls={TabId.EMAIL} aria-selected={selected === TabId.EMAIL}>Email me</button>
			</li>
			<li class:list={[
					TAB_CLASS,
					"underline-on-hover",
					{
						[TAB_ACTIVE_CLASS]: selected === TabId.APPOINTMENT,
						"underline-on-hover--active": selected === TabId.APPOINTMENT,
					},
				]} data-target={TabId.APPOINTMENT} role="presentation">
				<button type="button" role="tab" id={`${TabId.APPOINTMENT}-tab`} aria-controls={TabId.APPOINTMENT} aria-selected={selected === TabId.APPOINTMENT}>
					Make an appointment
				</button>
			</li>
		</ul>
		<div id={TabId.EMAIL} class:list={[TAB_CONTENT_CLASS, { [TAB_CONTENT_ACTIVE_CLASS]: selected === TabId.EMAIL }]} role="tabpanel" aria-labelledby={`${TabId.EMAIL}-tab`} tabindex="0">
			<ContactFormProvider client:load />
		</div>
		<div id={TabId.APPOINTMENT} class:list={[TAB_CONTENT_CLASS, { [TAB_CONTENT_ACTIVE_CLASS]: selected === TabId.APPOINTMENT }]} role="tabpanel" aria-labelledby={`${TabId.APPOINTMENT}-tab`} tabindex="0">
			<div
				class={CALENDLY.WIDGET_CLASS}
				data-url={CALENDLY_MEETING_URL}
				data-resize="true"
			>
			</div>
		</div>
	</div>
</section>

<script>
	import { initTabs } from "./utils/tabs";

	document.addEventListener("astro:page-load", () => {
		initTabs();
	});
</script>
