---
import stretchArrow from "@assets/images/svg/stretch-arrow.svg?raw";

interface Props {
	class?: string;
	hasButtons?: boolean;
	hasDots?: boolean;
	isLooping?: boolean;
	slideCount?: number;
	label?: string;
}

const {
	class: className,
	hasButtons = true,
	hasDots = false,
	isLooping = false,
	slideCount = 0,
	label = "Slider",
} = Astro.props;

const dots = hasDots ? Array.from({ length: slideCount }, (_, index) => index) : [];
---

<div class={`slider-wrapper ${className ?? ''}`.trim()} data-has-buttons={hasButtons} data-has-dots={hasDots} data-is-looping={isLooping}>
	{hasButtons && !hasDots && (
		<button class="slider__btn slider__btn--prev" type="button" aria-label="Previous slide" disabled><Fragment set:html={stretchArrow} /></button>
	)}
	<ul class="slider__track">
		<slot />
	</ul>
	{hasButtons && !hasDots && (
		<button class="slider__btn slider__btn--next" type="button" aria-label="Next slide"><Fragment set:html={stretchArrow} /></button>
	)}
	{hasDots && (
		<nav class="slider__nav" aria-label={label}>
			<button class="slider__btn slider__btn--prev" type="button" aria-label="Previous slide" disabled={!isLooping}><Fragment set:html={stretchArrow} /></button>
			{dots.map((index) => (
				<button
					class:list={["slider__dot clickable", { "slider__dot--active": index === 0 }]}
					type="button"
					data-index={index}
					aria-label={`Go to slide ${index + 1}`}
				/>
			))}
			<button class="slider__btn slider__btn--next" type="button" aria-label="Next slide"><Fragment set:html={stretchArrow} /></button>
		</nav>
	)}
</div>

<script>
	import { initSlider } from "@modules/core/components/sliderShell/utils/slider";

	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLElement>('.slider-wrapper[data-has-buttons="true"]').forEach(initSlider);
	});
</script>
