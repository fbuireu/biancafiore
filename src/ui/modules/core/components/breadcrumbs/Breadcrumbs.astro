---
import { createBreadcrumbs } from "@domain/breadcrumb";
import { buildBreadcrumbListSchema } from "@modules/core/utils/jsonLd";
import { siteChrome } from "@modules/core/utils/siteChrome";
import "./breadcrumbs.css";

const { pathname: currentPath, origin: originPath } = Astro.url;

const { showsBreadcrumbs } = siteChrome(Astro.url);
const breadcrumbs = createBreadcrumbs({ currentPath });
const breadcrumbListSchema = buildBreadcrumbListSchema(
	breadcrumbs.map(({ link, label }) => ({ name: label, url: `${originPath}${link}` })),
);
---
{showsBreadcrumbs && (
<section class="breadcrumbs-wrapper common-wrapper">
    <ul class="breadcrumbs__list flex justify-center align-center font-sans-serif">
      {breadcrumbs?.map(({ link, label }) => {
        const isLast = breadcrumbs.at(-1)?.link === link;

        return (
            <li class="breadcrumb__item flex">
              {!isLast ? (
                  <a href={link} class="underline-on-hover clickable">{label}</a><span>/</span>
              ) : (
                  <strong class="current-page">{label}</strong>
              )}
            </li>
        );
      })}
    </ul>
    <script is:inline type="application/ld+json" set:html={breadcrumbListSchema} />
</section>
)}
