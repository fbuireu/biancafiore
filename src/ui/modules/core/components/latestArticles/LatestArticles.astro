---
import { getCollection } from "astro:content";
import { absoluteUrl, articleHref, PAGES_ROUTES } from "@const/index";
import ArticleSlider from "@modules/core/components/articleSlider/ArticleSlider.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import "./latest-articles.css";

interface Props {
	limit?: number;
}

const MAX_LATEST_ARTICLES = 4;

const { limit = MAX_LATEST_ARTICLES } = Astro.props;

const articles = (await getCollection("articles")).slice(0, limit);
const itemListSchema = buildItemListSchema(articles.map(({ data: { slug } }) => absoluteUrl(articleHref(slug))));
---
<section class="latest-articles-wrapper inverted-color-scheme">
    <h2 class="latest-articles__title section-title reveal">
        Fresh from <a class="latest-articles__title__link clickable underline-on-hover"
                      href={`${PAGES_ROUTES.ARTICLES}`}>the blog</a>
    </h2>
    <ArticleSlider articles={articles} class="latest-articles__slider common-wrapper" />
    <script is:inline type="application/ld+json" set:html={itemListSchema} />
</section>
