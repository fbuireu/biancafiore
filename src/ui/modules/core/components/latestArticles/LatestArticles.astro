---
import { getCollection } from "astro:content";
import { SITE_URL } from "astro:env/client";
import { PAGES_ROUTES } from "@const/index";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import LatestArticlesSlider from "./atoms/latestArticlesSlider/LatestArticlesSlider.astro";
import "./latest-articles.css";

interface Props {
	limit?: number;
}

const MAX_LATEST_ARTICLES = 4;

const { limit = MAX_LATEST_ARTICLES } = Astro.props;

const articles = (await getCollection("articles")).slice(0, limit);
const itemListSchema = buildItemListSchema(
	articles.map(({ data: { slug } }) => new URL(`${PAGES_ROUTES.ARTICLE}${slug}`, SITE_URL).href),
);
---
<section class="latest-articles-wrapper --inverted-color-scheme">
    <h2 class="latest-articles__title section-title">
        Fresh from <a class="latest-articles__title__link --is-clickable --underline-on-hover"
                      href={`${PAGES_ROUTES.ARTICLES}`}>the blog</a>
    </h2>
    <LatestArticlesSlider articles={articles} />
    <script is:inline type="application/ld+json" set:html={itemListSchema} />
</section>
