---
import type { CollectionEntry } from "astro:content";
import stretchArrow from "@assets/images/svg/stretch-arrow.svg?raw";
import { articleHref, tagHref } from "@const/index";
import { toArticleCardContent } from "@modules/core/components/articleCard/utils/card";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import clsx from "clsx";
import "./article-card.css";

interface Props {
	article: CollectionEntry<"articles">;
	isLandscape?: boolean;
}

const { article, isLandscape = false } = Astro.props;

const {
	slug,
	title,
	description,
	publishDate,
	publishDateISO,
	readingTime,
	author,
	featuredImage,
	visibleTags,
	remainingTags,
} = toArticleCardContent(article);
---
<a class="article-card__link" href={articleHref(slug)} aria-labelledby={`article-title-${slug}`}>{' '}</a>
<article
    class={clsx('article-card__item', { 'article-card__item--landscape': isLandscape })}
>
  {featuredImage && (
      <div class="article-card__media">
          <BlurImage
              class="article-card__featured-image"
              image={featuredImage}
              alt={title}
              transitionName={`featured-image-${slug}`}
          />
      </div>
  )}
    <time class="article-card__publish-date editorial-meta editorial-meta--gold" datetime={publishDateISO}>
      {publishDate}
    </time>
    <h3 class="article-card__title" id={`article-title-${slug}`}>
      {title} <span class="article-card__arrow" aria-hidden="true" set:html={stretchArrow} />
    </h3>
    <p class="article-card__byline editorial-meta">
        by <a href={tagHref(author.slug)}
              class="article-card__author clickable underline-on-hover">{author.name}</a>
        · {readingTime} min
    </p>
    <div class="article-card__switch">
        <p class="article-card__excerpt">{description}</p>
        <div class="article-card__topics">
            <p class="article-card__kicker editorial-kicker">In this story</p>
            <ul class="article-card__tags__list">
              {visibleTags.map(({ slug: tagSlug, name }) => (
                  <li class="article-card__tag__item">
                      <a class="clickable underline-on-hover" href={tagHref(tagSlug)}>{name}</a>
                  </li>
              ))}
              {remainingTags > 0 && (
                  <li class="article-card__tag__item article-card__tags__overflow">+{remainingTags}</li>
              )}
            </ul>
        </div>
    </div>
</article>
