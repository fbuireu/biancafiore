---
import { EMAIL_ADDRESS_PLACEHOLDER, EMAIL_BUTTON_ADDRESS_CLASS, EMAIL_BUTTON_CLASS } from "./const";
import "./email-button.css";

type Props = { classNames?: string } & ({ shows?: "label"; label?: string } | { shows: "address"; label?: never });

const { classNames, shows = "label", label = "Email" } = Astro.props;
const showsAddress = shows === "address";
---
<button
  type="button"
  class:list={[classNames, "underline-on-hover", EMAIL_BUTTON_CLASS, showsAddress && EMAIL_BUTTON_ADDRESS_CLASS]}
>{showsAddress ? EMAIL_ADDRESS_PLACEHOLDER : label}</button>

<script>
  import { activateEmailButtons } from "@modules/core/components/emailButton/utils/interactions";

  document.addEventListener("astro:page-load", () => activateEmailButtons());
</script>
