---
import { TWITTER_HANDLE } from "astro:env/client";
import type { Seo } from "./utils/pageSeo";

interface Props {
	seo: Seo;
}

const { seo } = Astro.props;
---
<title>{seo.documentTitle}</title>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="color-scheme" content="light dark">
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" href="/favicon-light-32.png"/>
<link rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" href="/favicon-dark-32.png"/>
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
<link rel="canonical" href={seo.canonical}/>
<link rel="sitemap" href="/sitemap.xml"/>
<meta name="googlebot" content={seo.robots}/>
{seo.tags.length > 0 && <meta name="keywords" content={seo.tags.join(", ")}/>}
<meta property="og:url" content={seo.canonical}/>
<meta property="og:image:alt" content={seo.title}/>
{seo.imageWidth && <meta property="og:image:width" content={String(seo.imageWidth)}/>}
{seo.imageHeight && <meta property="og:image:height" content={String(seo.imageHeight)}/>}
<meta property="og:site_name" content={seo.siteName}/>
<meta property="og:locale" content={seo.locale}/>
{seo.tags.map((tag) => <meta property="article:tag" content={tag}/>)}
<meta name="twitter:url" content={seo.canonical}/>
<meta name="twitter:image:alt" content={seo.title}/>
<meta name="twitter:creator" content={TWITTER_HANDLE}/>
<meta name="twitter:site" content={TWITTER_HANDLE}/>
