---
import { PAGES_ROUTES, SITE_AUTHOR_SLUG, tagHref } from "@const/index";
import "./under-construction.css";
---
<div class="under-construction">
    <h1 class="under-construction__title">Site under construction<br />We'll be back soon</h1>
    <p class="under-construction__text">
      In the meantime, you can read what I've already written: browse <a href={PAGES_ROUTES.TAGS} class="under-construction__link">all the tags</a> or head straight to <a href={tagHref(SITE_AUTHOR_SLUG)} class="under-construction__link">Bianca Fiore</a>.
    </p>
</div>
