---
import type { HTMLAttributes } from "astro/types";
import { isWithin } from "../../../../utils/pathname";

type Props = HTMLAttributes<"a">;

const { href, class: classNames, ...props } = Astro.props;

const isCurrentPage = isWithin({ pathname: Astro.url.pathname, route: String(href) });
---
<a
    href={href}
    class:list={[`clickable ${classNames}`, { 'current-page': isCurrentPage }]}
    aria-current={isCurrentPage ? 'page' : undefined}
    {...props}
>
  <slot />
</a>
