---
import { PAGES_ROUTES } from "@const/index";
import HeaderLink from "../headerLink/HeaderLink.astro";
import "./menu.css";
---
<section class="header__menu" id="header-menu">
    <div class="navigation__menu">
        <div class="navigation__menu__inner common-wrapper">
            <blockquote class="navigation__menu__quote flex row-wrap align-center">
                <p>Every story is someone's, and the job is to find the person in it before you find the words.</p>
                <cite>Bianca Fiore</cite>
            </blockquote>
            <hr class="navigation__menu__divider" />
            <nav class="navigation__menu__nav column-nowrap flex">
                <div class="navigation__menu__item">
                    <span>back to start</span>
                    <HeaderLink href={`${PAGES_ROUTES.HOME}`} class="navigation__menu__link underline-on-hover">Home
                    </HeaderLink>
                </div>
                <div class="navigation__menu__item">
                    <HeaderLink href={`${PAGES_ROUTES.PROJECTS}`} class="navigation__menu__link underline-on-hover">
                        Projects
                    </HeaderLink>
                    <span>I worked on</span>
                </div>
                <div class="navigation__menu__item">
                    <span>my</span>
                    <HeaderLink href={`${PAGES_ROUTES.ARTICLES}`} class="navigation__menu__link underline-on-hover">
                        Articles
                    </HeaderLink>
                </div>
                <div class="navigation__menu__item">
                    <span>know more</span>
                    <HeaderLink href={`${PAGES_ROUTES.ABOUT}`} class="navigation__menu__link underline-on-hover">About
                    </HeaderLink>
                    <span>me</span>
                </div>
                <div class="navigation__menu__item">
                    <HeaderLink href={`${PAGES_ROUTES.CONTACT}`} class="navigation__menu__link underline-on-hover">
                        Contact
                    </HeaderLink>
                    <span>me</span>
                </div>
            </nav>
        </div>
    </div>
</section>
