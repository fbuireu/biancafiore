---
import { PAGES_ROUTES } from "@const/index";
import { HEADER_MENU_CLASS, HEADER_MENU_ITEM_CLASS, HEADER_MENU_NAV_CLASS, HEADER_MENU_QUOTE_CLASS } from "../../const";
import HeaderLink from "../headerLink/HeaderLink.astro";
import "./menu.css";
---
<section class={HEADER_MENU_CLASS} id="header-menu">
    <div class="header__menu__panel">
        <div class="header__menu__inner common-wrapper">
            <blockquote class:list={[HEADER_MENU_QUOTE_CLASS, "flex", "row-wrap", "align-center"]}>
                <p>Every story is someone's, and the job is to find the person in it before you find the words.</p>
                <cite>Bianca Fiore</cite>
            </blockquote>
            <hr class="header__menu__divider" />
            <nav class:list={[HEADER_MENU_NAV_CLASS, "column-nowrap", "flex"]}>
                <div class={HEADER_MENU_ITEM_CLASS}>
                    <span>back to start</span>
                    <HeaderLink href={`${PAGES_ROUTES.HOME}`} class="header__menu__link underline-on-hover">Home
                    </HeaderLink>
                </div>
                <div class={HEADER_MENU_ITEM_CLASS}>
                    <HeaderLink href={`${PAGES_ROUTES.PROJECTS}`} class="header__menu__link underline-on-hover">
                        Projects
                    </HeaderLink>
                    <span>I worked on</span>
                </div>
                <div class={HEADER_MENU_ITEM_CLASS}>
                    <span>my</span>
                    <HeaderLink href={`${PAGES_ROUTES.ARTICLES}`} class="header__menu__link underline-on-hover">
                        Articles
                    </HeaderLink>
                </div>
                <div class={HEADER_MENU_ITEM_CLASS}>
                    <span>know more</span>
                    <HeaderLink href={`${PAGES_ROUTES.ABOUT}`} class="header__menu__link underline-on-hover">About
                    </HeaderLink>
                    <span>me</span>
                </div>
                <div class={HEADER_MENU_ITEM_CLASS}>
                    <HeaderLink href={`${PAGES_ROUTES.CONTACT}`} class="header__menu__link underline-on-hover">
                        Contact
                    </HeaderLink>
                    <span>me</span>
                </div>
            </nav>
        </div>
    </div>
</section>
