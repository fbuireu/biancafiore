---
import { MENU_NAME } from "@domain/menu";
import { readMenu } from "../../../../utils/entries";
import { HEADER_MENU_CLASS, HEADER_MENU_ITEM_CLASS, HEADER_MENU_NAV_CLASS, HEADER_MENU_QUOTE_CLASS } from "../../const";
import HeaderLink from "../headerLink/HeaderLink.astro";
import "./menu.css";

const { items } = await readMenu({ name: MENU_NAME.HEADER, prerendered: Astro.isPrerendered });
---
<section class={HEADER_MENU_CLASS} id="header-menu">
    <div class="header__menu__panel">
        <div class="header__menu__inner common-wrapper">
            <blockquote class:list={[HEADER_MENU_QUOTE_CLASS, "flex", "row-wrap", "align-center"]}>
                <p>Every story is someone's, and the job is to find the person in it before you find the words.</p>
                <cite>Bianca Fiore</cite>
            </blockquote>
            <hr class="header__menu__divider" />
            <nav class:list={[HEADER_MENU_NAV_CLASS, "column-nowrap", "flex"]}>
                {items.map(({ before, label, after, href, opensInNewTab }) => (
                    <div class={HEADER_MENU_ITEM_CLASS}>
                        {before && <span>{before}</span>}
                        <HeaderLink
                            href={href}
                            class="header__menu__link underline-on-hover"
                            {...(opensInNewTab && { target: "_blank", rel: "noopener noreferrer" })}
                        >
                            {label}
                        </HeaderLink>
                        {after && <span>{after}</span>}
                    </div>
                ))}
            </nav>
        </div>
    </div>
</section>
