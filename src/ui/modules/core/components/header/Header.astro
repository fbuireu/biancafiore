---
import Logo from "@modules/core/components/logo/Logo.astro";
import Menu from "./atoms/menu/Menu.astro";
import MenuButton from "./atoms/menuButton/MenuButton.astro";
import MenuOverlay from "./atoms/menuOverlay/MenuOverlay.astro";
import "./header.css";
---
<header class="header">
    <div class="header__backdrop"></div>
    <section class="header__inner common-wrapper flex row-wrap justify-flex-end align-center">
        <Logo />
        <MenuButton />
    </section>
    <MenuOverlay />
    <Menu />
</header>
<script>
	import { toggleMenu, watchBackground } from "@modules/core/components/header/utils/interactions";

	document.addEventListener("astro:page-load", () => {
		watchBackground();
		toggleMenu();
	});
</script>
