---
import type { RemoteImageProps } from "astro:assets";
import { Image } from "astro:assets";
import type { Except } from "@const/types";
import type { ImageDTO } from "@domain/shared/image";
import "./blur-image.css";

interface OwnProps {
	image: ImageDTO;
	transitionName?: string;
}

type Props = Except<RemoteImageProps, "src" | "width" | "height"> & OwnProps;

const { image, transitionName, ...rest } = Astro.props;
const lqip = image.placeholder ? `--lqip: url("${image.placeholder}")` : undefined;
---
<div class="blur-image" style={lqip}>
    <Image
        src={image.url}
        width={image.details.width}
        height={image.details.height}
        transition:name={transitionName}
        {...rest}
    />
</div>
