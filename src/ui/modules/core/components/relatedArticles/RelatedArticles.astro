---
import type { CollectionEntry } from "astro:content";
import { resolveArticles } from "../../utils/entries";
import { buildArticleListSchema } from "../../utils/jsonLd";
import ArticleSlider from "../articleSlider/ArticleSlider.astro";
import JsonLd from "../jsonLd/JsonLd.astro";
import "./related-articles.css";

interface Props {
	article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
const relatedArticles = await resolveArticles(article.data.relatedArticles);
const itemListSchema = buildArticleListSchema(relatedArticles.map(({ data }) => data.slug));
---
{
    relatedArticles.length > 0 && (
    <section class="related-articles inverted-color-scheme">
      <div class="related-articles-wrapper common-wrapper">
        <h2 class="related-articles__title section-title reveal">You might also like</h2>
        <ArticleSlider articles={relatedArticles} class="related-articles__slider common-wrapper" isShuffled />
        <JsonLd schema={itemListSchema} />
      </div>
    </section>
        )
    }
