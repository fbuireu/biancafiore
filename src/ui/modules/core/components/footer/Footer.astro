---
import Logo from "@assets/images/svg/logo.svg";
import { PAGES_ROUTES } from "@const/index";
import { MENU_NAME } from "@domain/menu";
import { readMenu } from "../../utils/entries";
import CarbonBadge from "../carbonBadge/CarbonBadge.astro";
import CookieConsent from "../cookieConsent/CookieConsent.astro";
import SocialNetworks from "../socialNetworks/SocialNetworks.astro";
import ThemeToggle from "../themeToggle/ThemeToggle.astro";
import "./footer.css";

const currentYear = new Date().getFullYear();
const { items: legalLinks } = await readMenu({ name: MENU_NAME.FOOTER, prerendered: Astro.isPrerendered });
---
<footer class="footer inverted-color-scheme">
    <section class="footer-wrapper common-wrapper">
        <div class="footer__logo flex row-wrap justify-center">
            <a href={PAGES_ROUTES.HOME}>
                <Logo />
            </a>
        </div>
        <ThemeToggle />
        <SocialNetworks />
        <p class="footer__legal-pages flex justify-center">
            {legalLinks.map(({ label, href, opensInNewTab }) => (
                <a href={href} rel="nofollow noreferrer" class="underline-on-hover" target={opensInNewTab ? "_blank" : undefined}>{label}</a>
            ))}
            <CookieConsent />
        </p>
        <p class="footer__disclaimer flex justify-center">
            &copy; {currentYear} &nbsp; <span translate="no">Bianca Fiore</span>. All rights reserved.
        </p>
        <div class="footer__carbon flex justify-center">
            <CarbonBadge />
        </div>
    </section>
</footer>
