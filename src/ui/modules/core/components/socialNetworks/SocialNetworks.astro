---
import EmailButton from "../emailButton/EmailButton.astro";
import { SOCIAL_NETWORKS } from "./const";
import "./social-networks.css";
---
<ul class="social-networks__list flex row-wrap">
  {Object.entries(SOCIAL_NETWORKS).map(([key, value]) => (
      <li class="social-networks__item">
          <a
              href={value}
              target="_blank"
              rel="external"
              class="social-networks__link underline-on-hover"
          >
            {key.toLowerCase()}
          </a>
      </li>
  ))}
    <li class="social-networks__item">
        <EmailButton classNames="social-networks__link" />
    </li>
</ul>
