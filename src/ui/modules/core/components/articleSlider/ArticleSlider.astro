---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "../articleCard/ArticleCard.astro";
import { SLIDER_SLIDE_CLASS } from "../sliderShell/const";
import SliderShell from "../sliderShell/SliderShell.astro";
import "./article-slider.css";

interface Props {
	articles: CollectionEntry<"articles">[];
	class?: string;
}

const { articles, class: className } = Astro.props;
---

<SliderShell class={`${className ?? ''} article-slider`.trim()}>
	{
		articles.map((article) => (
			<li class:list={[SLIDER_SLIDE_CLASS, "item-wrapper", "reveal"]}>
				<ArticleCard article={article} />
			</li>
		))
	}
</SliderShell>
