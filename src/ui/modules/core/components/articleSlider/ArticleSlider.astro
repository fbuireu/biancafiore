---
import type { CollectionEntry } from "astro:content";
import ArticleCard from "@modules/core/components/articleCard/ArticleCard.astro";
import SliderShell from "@modules/core/components/sliderShell/SliderShell.astro";

interface Props {
	articles: CollectionEntry<"articles">[];
	class?: string;
}

const { articles, class: className } = Astro.props;
---

<SliderShell class={`${className ?? ''} slider-wrapper--reveal-items`.trim()}>
	{
		articles.map((article, index) => (
			<li class="slider__slide item-wrapper reveal" data-reveal-index={index}>
				<ArticleCard {...article} />
			</li>
		))
	}
</SliderShell>
