---
import type { CollectionEntry } from "astro:content";
import { articleHref, tagHref } from "@const/index";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import LinkWithArrow from "@modules/core/components/linkWithArrow/LinkWithArrow.astro";
import { buildArticleShareLinks } from "./utils/share";
import "./featured-article.css";

interface Props {
	featuredArticle: CollectionEntry<"articles">;
}

const { featuredArticle } = Astro.props;
const featuredArticleUrl = articleHref(featuredArticle.data.slug);
const shareLinks = buildArticleShareLinks({
	slug: featuredArticle.data.slug,
	title: featuredArticle.data.title,
	tags: featuredArticle.data.tags,
});
---
<div class="articles-wrapper">
    <section class="articles-wrapper__inner common-wrapper">
        <div class="featured-article-wrapper reveal">
            <a href={featuredArticleUrl}>
                <BlurImage
                    class="featured-article__image"
                    image={featuredArticle.data.featuredImage!}
                    alt={featuredArticle.data.title}
                    loading="eager"
                />
            </a>
            <div class="featured-article__details-wrapper flex row-wrap">
                <a class="featured-article__link-card" href={featuredArticleUrl}
                   aria-labelledby="featured-article-title">{' '}</a>
                <div class="featured-article__details flex column-wrap">
                    <time class="featured-article__publish-date font-sans-serif"
                          datetime={featuredArticle.data.publishDateISO}>
                      {featuredArticle.data.publishDate}
                    </time>
                    <h2 class="featured-article__title" id="featured-article-title">{featuredArticle.data.title}</h2>
                    <p class="featured-article__description" set:html={featuredArticle.data.description} />
                  {
                      (featuredArticle.data.tags?.length ?? 0) > 0 && (
                          <ul class="featured-article__tags__list flex">
                            {featuredArticle.data.tags?.map(({ name, slug }) => (
                                <a class="featured-article__tag__item underline-on-hover" href={tagHref(slug)}>
                                    #{name}
                                </a>
                            ))}
                          </ul>
                      )
                  }
                <LinkWithArrow href={featuredArticleUrl} classNames="featured-article__cta">
                    Read more
                </LinkWithArrow>
                </div>
                <div class="featured-article__share-wrapper flex row-wrap">
                    <p class="featured-article__share__title font-serif">SHARE IT!</p>
                    <ul class="featured-article__share__links__list flex">
                        <li class="featured-article__share__link__item underline-on-hover clickable">
                            <a
                                target="_blank"
                                rel="noopener noreferrer"
                                href={shareLinks.linkedin}
                            >
                                Linkedin
                            </a>
                        </li>
                        <li class="featured-article__share__link__item underline-on-hover clickable">
                            <a
                                target="_blank"
                                rel="external"
                                href={shareLinks.x}>
                                X (former Twitter)
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
</div>
