---
import { Image } from "astro:assets";
import { absoluteUrl } from "@const/routes";
import "./article-image.css";

interface Props {
	node: {
		src: string;
		alt: string;
		width?: number;
		height?: number;
		placeholder?: string;
		caption?: string;
		layout?: string;
	};
}

const { src, alt, width, height, placeholder, caption, layout } = Astro.props.node;
---
<figure class:list={["article-image", layout && `article-image--${layout}`]}>
    <span class="article-image__frame" style={placeholder && `--lqip: url("${placeholder}")`}>
        {width && height ? (
            <Image src={absoluteUrl(src)} width={width} height={height} sizes="auto" alt={alt} />
        ) : (
            <img src={src} alt={alt} loading="lazy" decoding="async" />
        )}
    </span>
    {caption && <figcaption>{caption}</figcaption>}
</figure>
