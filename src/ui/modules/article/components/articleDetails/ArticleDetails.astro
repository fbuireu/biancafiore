---
import type { CollectionEntry } from "astro:content";
import { tagHref } from "@const/index";
import { formatPublishDate } from "@domain/article";
import "./article-details.css";

interface Props {
	article: CollectionEntry<"articles">;
}

const { article } = Astro.props;
---
<div class="article-details">
    <time class="article-details__publish-date font-sans-serif" datetime={article.data.publishDateISO}>
      {formatPublishDate(article.data.publishDateISO)}
    </time>
    <h1 class="article-details__title editorial-headline">
      {article.data.title}
    </h1>
    <p class="article-details__byline font-sans-serif">
      by <a class="underline-on-hover" href={tagHref(article.data.author.slug)}>{article.data.author.name}</a>
      <span class="article-details__byline__sep" aria-hidden="true">·</span>
      {article.data.readingTime} minutes read
    </p>
  {
      (article.data.tags?.length ?? 0) > 0 && (
          <ul class="article-details__tags__list flex row-wrap justify-center">
            {article.data.tags?.map(({ slug, name }) => (
                <li class="article-details__tag__item font-sans-serif">
                    <a href={tagHref(slug)} class="underline-on-hover">#{name}</a>
                </li>
            ))}
          </ul>
      )
  }
</div>
