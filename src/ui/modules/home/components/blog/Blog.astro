---
import { getCollection } from "astro:content";
import { SITE_URL } from "astro:env/client";
import stretchArrow from "@assets/images/svg/stretch-arrow.svg?raw";
import { PAGES_ROUTES } from "@const/index";
import ArticleCard from "@modules/core/components/articleCard/ArticleCard.astro";
import { buildItemListSchema } from "@modules/core/utils/jsonLd";
import "./blog.css";

interface Props {
	limit?: number;
}

const MAX_ARTICLES = 3;

const { limit = MAX_ARTICLES } = Astro.props;

const articles = (await getCollection("articles")).slice(0, limit);
const itemListSchema = buildItemListSchema(
	articles.map(({ data: { slug } }) => new URL(`${PAGES_ROUTES.ARTICLE}${slug}`, SITE_URL).href),
);
---
<section class="blog --inverted-color-scheme">
    <div class="blog__inner">
        <h2 class="blog__title editorial-section-title reveal">
            Fresh from <a class="blog__title__link --is-clickable --underline-on-hover"
                          href={PAGES_ROUTES.ARTICLES}>the Blog</a>
        </h2>
        <ul class="blog__list">
          {articles.map((article, index) => (
              <li class="blog__item item-wrapper reveal" data-reveal-index={index}>
                  <ArticleCard {...article} />
              </li>
          ))}
        </ul>
        <div class="blog__footer reveal">
            <a class="editorial-cta" href={PAGES_ROUTES.ARTICLES}>
                All articles <span class="editorial-cta__arrow" aria-hidden="true" set:html={stretchArrow} />
            </a>
        </div>
        <script is:inline type="application/ld+json" set:html={itemListSchema} />
    </div>
</section>
