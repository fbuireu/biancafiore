---
import type { CollectionEntry } from "astro:content";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import { SLIDER_SLIDE_CLASS } from "@modules/core/components/sliderShell/const";
import SliderShell from "@modules/core/components/sliderShell/SliderShell.astro";
import "./testimonials-slider.css";

interface Props {
	testimonials: CollectionEntry<"testimonials">[];
}

const { testimonials } = Astro.props;
---

<div class="reveal">
	<SliderShell
		class="testimonials-slider__slider"
		hasDots
		isLooping
		slideCount={testimonials.length}
		label="Testimonials navigation"
	>
		{
			testimonials.map((testimonial) => (
				<li class={SLIDER_SLIDE_CLASS}>
					<figure class="testimonials-slider__testimonial">
						<blockquote class="testimonials-slider__quote">{testimonial.data.quote}</blockquote>
						<figcaption class="testimonials-slider__attribution">
							<BlurImage
								class="testimonials-slider__avatar"
								image={testimonial.data.image}
								alt={testimonial.data.quotee}
								loading="lazy"
							/>
							<span class="testimonials-slider__identity">
								<span class="testimonials-slider__quotee">{testimonial.data.quotee}</span>
								<span class="editorial-meta testimonials-slider__role">{testimonial.data.role}</span>
							</span>
						</figcaption>
					</figure>
				</li>
			))
		}
	</SliderShell>
</div>
