---
import { getCollection } from "astro:content";
import stretchArrow from "@assets/images/svg/stretch-arrow.svg?raw";
import JsonLd from "@modules/core/components/jsonLd/JsonLd.astro";
import "./my-work.css";
import { projectHref } from "@const/index";
import BlurImage from "@modules/core/components/blurImage/BlurImage.astro";
import { buildProjectListSchema } from "@modules/core/utils/jsonLd";

const projects = await getCollection("projects");

const disciplinesCount = String(projects.length).padStart(2, "0");
const itemListSchema = buildProjectListSchema(projects.map(({ data }) => data.id));
---
<section class="my-work">
    <div class="my-work__inner">
        <header class="my-work__header reveal">
            <h2 class="my-work__title editorial-section-title">My&nbsp;Work</h2>
            <p class="editorial-meta">{disciplinesCount} Disciplines</p>
        </header>
        {projects.map((project, index) => {
          const projectUrl = projectHref(project.data.id);

          return (
              <details class="my-work__item reveal" name="my-work" data-reveal-index={index}>
                  <summary class="my-work__summary">
                      <h3 class="my-work__name">{project.data.name}</h3>
                      <BlurImage
                          class="my-work__thumbnail"
                          image={project.data.image}
                          alt={project.data.name}
                          loading="lazy"
                      />
                  </summary>
                  <div class="my-work__panel">
                      <article class="my-work__description" set:html={project.data.description} />
                      <a class="editorial-cta" href={projectUrl}>
                          More details <span class="editorial-cta__arrow" aria-hidden="true" set:html={stretchArrow} />
                      </a>
                  </div>
              </details>
          );
        })}
    </div>
    <JsonLd schema={itemListSchema} />
</section>
