{
	"name": "biancafiore",
	"version": "1.29.4",
	"private": true,
	"description": "Portfolio and blog of content writer Bianca Fiore. Astro on Cloudflare Workers, content from the EmDash CMS it hosts itself",
	"keywords": [
		"portfolio",
		"blog",
		"content-writing",
		"ngo",
		"seo",
		"astro",
		"react",
		"typescript",
		"effect-ts",
		"emdash",
		"turso",
		"drizzle-orm",
		"resend",
		"cloudflare-workers"
	],
	"author": "Ferran Buireu <fbuireu@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fbuireu/biancafiore.git"
	},
	"homepage": "https://biancafiore.me",
	"bugs": {
		"url": "https://github.com/fbuireu/biancafiore/issues"
	},
	"type": "module",
	"engines": {
		"node": "26.7.0"
	},
	"packageManager": "pnpm@12.10.1",
	"scripts": {
		"prepare": "husky",
		"dev": "astro dev",
		"dev:open": "pnpm dev --open",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "wrangler deploy --env production",
		"wrangler:dev": "pnpm build && wrangler dev --remote",
		"sync": "astro sync",
		"check": "astro check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format .",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched .",
		"typecheck": "pnpm sync && tsc --project . --noEmit",
		"test:ut": "vitest run --logHeapUsage --project node --project dom",
		"test:ut:watch": "vitest --logHeapUsage --project node --project dom",
		"test:ut:coverage": "pnpm test:ut --coverage",
		"test:ut:changed": "pnpm test:ut --changed origin/main",
		"test:docs": "pnpm test:ut docs/docs-consistency.test.ts",
		"test:all": "pnpm test:ut && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "pnpm test:e2e --ui",
		"verify:static": "pnpm format:check && pnpm typecheck && pnpm check",
		"verify": "pnpm verify:static && pnpm test:ut:coverage",
		"verify:changed": "pnpm verify:static && pnpm test:ut:changed && pnpm test:docs",
		"test:built": "pnpm build && vitest run --project built",
		"test:e2e:changed": "pnpm test:e2e --only-changed --pass-with-no-tests"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.3.4",
		"@astrojs/compiler-rs": "0.5.1",
		"@astrojs/react": "7.0.1",
		"@astrojs/rss": "4.0.19",
		"@emdash-cms/cloudflare": "1.2.0",
		"@hookform/resolvers": "5.9.1",
		"@libsql/client": "0.18.0",
		"@tgwf/co2": "0.19.0",
		"astro": "7.3.8",
		"blurhash": "2.0.5",
		"clsx": "2.1.1",
		"drizzle-orm": "0.45.4",
		"effect": "4.0.3",
		"emdash": "1.2.0",
		"gsap": "3.15.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-email": "6.11.1",
		"react-globe.gl": "2.38.0",
		"react-google-recaptcha-v3": "1.11.0",
		"react-hook-form": "7.89.0",
		"resend": "6.32.1",
		"three": "0.186.1",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/ts-plugin": "1.10.12",
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@commitlint/format": "21.2.3",
		"@commitlint/types": "21.2.3",
		"@playwright/test": "1.64.0",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/github": "12.0.10",
		"@semantic-release/npm": "13.2.0",
		"@semantic-release/release-notes-generator": "14.1.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "0.186.0",
		"@vitest/coverage-v8": "5.0.3",
		"drizzle-kit": "0.31.11",
		"happy-dom": "20.14.6",
		"husky": "9.1.7",
		"lightningcss": "1.33.0",
		"lint-staged": "17.6.0",
		"msw": "3.0.3",
		"oxc-transform-react": "0.153.0",
		"semantic-release": "25.0.9",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.3",
		"wrangler": "4.149.0"
	}
}
