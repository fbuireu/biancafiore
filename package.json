{
	"name": "biancafiore",
	"description": "A portfolio for the best content writer ever",
	"keywords": [
		"astro",
		"typescript",
		"css",
		"cloudflare",
		"NGO",
		"blog",
		"portfolio",
		"marketing",
		"content writing",
		"seo",
		"turso",
		"resend"
	],
	"author": "Ferran Buireu <fbuireu@gmail.com>",
	"version": "1.21.0",
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "26.7.0"
	},
	"scripts": {
		"prepare": "husky",
		"start": "astro dev",
		"start:open": "pnpm start --open",
		"build": "astro build",
		"preview": "astro preview",
		"deploy": "wrangler deploy --env production",
		"wrangler:dev": "pnpm build && wrangler dev --remote",
		"sync": "astro sync",
		"check": "astro check",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:all": "pnpm format .",
		"format:changed": "pnpm format --changed",
		"format:check": "biome check --no-errors-on-unmatched .",
		"typecheck": "pnpm sync && tsc --project . --noEmit",
		"test:ut": "vitest run --logHeapUsage --project node --project dom",
		"test:ut:watch": "vitest --logHeapUsage",
		"test:ut:coverage": "pnpm test:ut --coverage",
		"test:ut:changed": "pnpm test:ut --changed",
		"test:docs": "pnpm test:ut docs/docs-consistency.test.ts",
		"test:all": "pnpm test:ut && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:ui": "pnpm test:e2e --ui",
		"test:e2e:changed": "pnpm test:e2e --only-changed --pass-with-no-tests",
		"verify": "pnpm format:check && pnpm typecheck && pnpm test:ut:coverage",
		"test:built": "pnpm build && vitest run --project built"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.2.2",
		"@astrojs/compiler-rs": "0.4.0",
		"@astrojs/react": "6.0.3",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@contentful/rich-text-html-renderer": "17.2.3",
		"@contentful/rich-text-types": "17.2.7",
		"@hookform/resolvers": "5.9.1",
		"@libsql/client": "0.17.4",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@tgwf/co2": "0.19.0",
		"astro": "7.2.3",
		"clsx": "2.1.1",
		"contentful": "11.12.9",
		"drizzle-orm": "0.45.2",
		"effect": "3.22.1",
		"gsap": "3.15.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-globe.gl": "2.38.0",
		"react-google-recaptcha-v3": "1.11.0",
		"react-hook-form": "7.85.0",
		"resend": "6.20.0",
		"three": "0.185.1",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/ts-plugin": "1.10.11",
		"@biomejs/biome": "2.5.9",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"@commitlint/format": "21.2.2",
		"@playwright/test": "1.62.1",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/npm": "13.1.5",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@types/three": "0.185.4",
		"@vitest/coverage-v8": "4.1.11",
		"drizzle-kit": "0.31.10",
		"happy-dom": "20.11.2",
		"husky": "9.1.7",
		"lightningcss": "1.33.0",
		"lint-staged": "17.3.0",
		"msw": "2.15.0",
		"semantic-release": "25.0.9",
		"typescript": "6.0.3",
		"vitest": "4.1.11",
		"wrangler": "4.124.0"
	}
}
