{
	"name": "biancafiore",
	"description": "A portfolio for the best content writer ever",
	"keywords": [
		"astro",
		"typescript",
		"css",
		"cloudflare",
		"NGO",
		"blog",
		"portfolio",
		"marketing",
		"content writing",
		"seo",
		"turso",
		"resend"
	],
	"author": "Ferran Buireu <fbuireu@gmail.com>",
	"version": "1.19.3",
	"type": "module",
	"packageManager": "pnpm@11.15.1",
	"engines": {
		"node": "26.5.0"
	},
	"scripts": {
		"prepare": "husky",
		"start": "astro dev",
		"start:open": "pnpm start --open",
		"build": "astro build",
		"deploy": "wrangler deploy --env production",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"wrangler:dev": "pnpm build && wrangler dev --remote",
		"preview": "astro preview",
		"sync": "astro sync",
		"check": "astro check",
		"test:all": "pnpm test:ut && pnpm test:e2e",
		"test:ut": "vitest --logHeapUsage",
		"test:ut:changed": "vitest related --run --passWithNoTests --bail=1",
		"test:docs": "vitest run docs/docs-consistency.test.ts",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:e2e:ui": "pnpm test:e2e --ui",
		"test:e2e:changed": "pnpm test:e2e --only-changed",
		"format": "biome check --write --no-errors-on-unmatched",
		"format:changed": "pnpm format --changed",
		"format:all": "pnpm format .",
		"lint": "biome lint --no-errors-on-unmatched",
		"lint:all": "pnpm lint .",
		"lint:all:fix": "pnpm lint:all --fix",
		"lint:changed": "pnpm lint --write --changed",
		"lint:ts:typecheck": "tsc --project . --noEmit"
	},
	"dependencies": {
		"@astrojs/cloudflare": "14.1.5",
		"@astrojs/compiler-rs": "0.3.1",
		"@astrojs/react": "6.0.1",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.3",
		"@contentful/rich-text-html-renderer": "17.2.3",
		"@contentful/rich-text-types": "17.2.7",
		"@hookform/resolvers": "5.4.0",
		"@libsql/client": "0.17.4",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@tgwf/co2": "0.19.0",
		"astro": "7.1.4",
		"clsx": "2.1.1",
		"contentful": "11.12.7",
		"drizzle-orm": "0.45.2",
		"effect": "3.22.0",
		"gsap": "3.15.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-globe.gl": "2.38.0",
		"react-google-recaptcha-v3": "1.11.0",
		"react-hook-form": "7.82.0",
		"resend": "6.18.0",
		"three": "0.185.1",
		"vanilla-cookieconsent": "3.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@astrojs/ts-plugin": "1.10.10",
		"@biomejs/biome": "2.5.5",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"@commitlint/format": "21.2.0",
		"@playwright/test": "1.61.1",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/npm": "13.1.5",
		"@testing-library/react": "16.3.2",
		"@types/node": "26.1.1",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.185.1",
		"@vitest/coverage-v8": "4.1.10",
		"drizzle-kit": "0.31.10",
		"happy-dom": "20.11.1",
		"husky": "9.1.7",
		"lightningcss": "1.33.0",
		"lint-staged": "17.1.1",
		"msw": "2.15.0",
		"semantic-release": "25.0.8",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"wrangler": "4.113.0"
	}
}
